{
  "name": "codamhero-v2",
  "version": "2.7.5",
  "description": "CodamHero v2 gives staff and students an overview of everything Codam.",
  "main": "build/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npx prisma generate && tsc",
    "start": "npx prisma migrate deploy && node build/main.js",
    "start:nosync": "npx prisma migrate deploy && node build/main.js --nosync",
    "start:readonly": "node build/main.js --readonly",
    "resetdb": "npx prisma migrate reset"
  },
  "keywords": [
    "codam",
    "42born2code"
  ],
  "author": "Freek Bes",
  "license": "MIT",
  "dependencies": {
    "@codam/fast42": "^3.1.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "cookie-session": "^2.1.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "node-cache": "^5.1.2",
    "nunjucks": "^3.2.4",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.20.0",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/nunjucks": "^3.2.6",
    "@types/passport": "^1.0.17",
    "@types/passport-oauth2": "^1.8.0",
    "typescript": "^5.9.3"
  }
}
