/**

DO NOT MODIFY THIS FILE WITHOUT CONSULTING CODAM STAFF.

This schema must stay in sync with the CodamDB database schema.

CodamHero-v2 can sync data from the Intra API itself, but we do not use that
path in production. In production it reads from CodamDB, Codam's own database,
which uses its own schema. Everything available in the Intra API is already
present in CodamDB.

To add a field:
1. Ask the Codam team which CodamDB table and field holds the data you need.
2. Add the field to schema.prisma.
3. Make sure the field is populated by the Intra API sync in this codebase,
   which only runs outside of production.

*/

generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
	schemas = ["internal", "intra_v2"]
}

model Synchronization {
	@@schema("internal")
	@@map("sync")

	id               Int      @id @default(autoincrement())
	type             String   @unique
	last_sync_date   DateTime
}

model User {
	@@schema("intra_v2")
	@@map("users")

	id               Int      @id
	email            String
	login            String
	first_name       String
	last_name        String
	usual_first_name String?
	usual_full_name  String?
	displayname      String
	kind             String
	image_url        String?
	pool_month       String?
	pool_year        String?
	wallet           Int      @default(0)
	anonymize_date   DateTime?
	alumnized_at     DateTime?

	created_at       DateTime
	updated_at       DateTime

	// Relations
	cursus_users     CursusUser[]
	project_users    ProjectUser[]
	locations        Location[]
	groups           GroupUser[]
}

model Cursus {
	@@schema("intra_v2")
	@@map("cursus")

	id               Int      @id
	name             String
	slug             String

	// Relations
	cursus_users     CursusUser[]
	projects_cursus  ProjectCursus[]
}

model CursusUser {
	@@schema("intra_v2")
	@@map("cursus_users")

	id               Int      @id
	cursus_id        Int      @map("cursus_id")
	user_id          Int      @map("user_id")
	begin_at         DateTime
	end_at           DateTime?
	blackholed_at    DateTime?
	level            Float
	grade            String?

	created_at       DateTime
	updated_at       DateTime

	// Relations
	user             User     @relation(fields: [user_id], references: [id])
	cursus           Cursus   @relation(fields: [cursus_id], references: [id])
}

model Group {
	@@schema("intra_v2")
	@@map("groups")

	id               Int      @id
	name             String

	// Relations
	group_users      GroupUser[]
}

model GroupUser {
	@@schema("intra_v2")
	@@map("groups_users")

	id               Int      @id
	group_id         Int      @map("group_id")
	user_id          Int      @map("user_id")

	// Relations
	user             User     @relation(fields: [user_id], references: [id])
	group            Group   @relation(fields: [group_id], references: [id])
}

model Project {
	@@schema("intra_v2")
	@@map("projects")

	id               Int      @id
	name             String
	slug             String
	exam             Boolean
	difficulty       Int

	updated_at       DateTime
	created_at       DateTime

	// Relations
	project_users    ProjectUser[]
	project_cursus   ProjectCursus[]
}

model ProjectCursus {
	@@schema("intra_v2")
	@@map("projects_cursus")

	id               Int      @id @default(autoincrement())
	project_id       Int      @map("project_id")
	cursus_id        Int      @map("cursus_id")

	// Relations
	project          Project  @relation(fields: [project_id], references: [id])
	cursus           Cursus   @relation(fields: [cursus_id], references: [id])
}

model ProjectUser {
	@@schema("intra_v2")
	@@map("projects_users")

	id               Int      @id
	project_id       Int      @map("project_id")
	user_id          Int      @map("user_id")
	final_mark       Int?
	status           String
	validated        Boolean?
	current_team_id  Int?

	created_at       DateTime
	updated_at       DateTime
	marked_at        DateTime?

	// Relations
	user             User     @relation(fields: [user_id], references: [id])
	project          Project  @relation(fields: [project_id], references: [id])
}

model Location {
	@@schema("intra_v2")
	@@map("locations")

	id               Int      @id
	primary          Boolean
	host             String
	user_id          Int      @map("user_id")
	begin_at         DateTime
	end_at           DateTime?

	// Relations
	user             User     @relation(fields: [user_id], references: [id])
}
